<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>C-BIOS</manufacturer>
    <code>MSX2</code>
    <release_year>2003</release_year>
    <description>The m6-msx2-128k machine with both cartridge slots expanded, so that an extension lands behind a secondary slot register: an MSX2 with a 128K memory mapper, using the C-BIOS build that hosts Nextor (release v0.29-nextor.1 of github.com/stefanobaldo/cbios), with an international keyboard layout and 60Hz interrupt frequency.</description>
    <type>MSX2</type>
    <region>int</region>
  </info>

  <MapperReadBackBits>largest</MapperReadBackBits>

  <CassettePort/>

  <devices>

    <primary slot="0">
      <ROM id="C-BIOS Main ROM">
        <mem base="0x0000" size="0x8000"/>
        <rom>
          <sha1>708097c2369046b65e6a41f5ca8ede2346fde93f</sha1>
          <filename>cbios_main_msx2.rom</filename>
        </rom>
      </ROM>

      <ROM id="C-BIOS Logo ROM">
        <mem base="0x8000" size="0x4000"/>
        <rom>
          <sha1>d4e5b98ce23573669fb44447582d656e390791c0</sha1>
          <filename>cbios_logo_msx2.rom</filename>
        </rom>
      </ROM>
    </primary>

    <primary slot="1">
      <secondary external="true" slot="0"/>
      <secondary external="true" slot="1"/>
      <secondary external="true" slot="2"/>
      <secondary external="true" slot="3"/>
    </primary>

    <primary slot="2">
      <secondary external="true" slot="0"/>
      <secondary external="true" slot="1"/>
      <secondary external="true" slot="2"/>
      <secondary external="true" slot="3"/>
    </primary>

    <primary slot="3">

      <secondary slot="0">
        <ROM id="C-BIOS Sub ROM">
          <mem base="0x0000" size="0x4000"/>
          <rom>
            <sha1>2fcb40413e7d373f0f2dbdc815ce18746ddf3684</sha1>
            <filename>cbios_sub.rom</filename>
          </rom>
        </ROM>
      </secondary>

      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <mem base="0x0000" size="0x10000"/>
          <size>128</size>
        </MemoryMapper>
      </secondary>

    </primary>

    <PPI id="ppi">
      <io base="0xA8" num="4"/>
      <sound>
        <volume>16000</volume>
      </sound>
      <key_ghosting>false</key_ghosting>
      <keyboard_type>int</keyboard_type>
      <has_keypad>true</has_keypad>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <io base="0x98" num="4" type="O"/>
      <io base="0x98" num="2" type="I"/>
      <version>V9938</version>
      <vram>128</vram>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <io base="0xA0" num="2" type="O"/>
      <io base="0xA2" num="1" type="I"/>
      <sound>
        <volume>21000</volume>
      </sound>
      <ignorePortDirections>true</ignorePortDirections> <!-- highest compatibility -->
    </PSG>

    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
      <sramname>m6-msx2-128k-exp.cmos</sramname>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

  </devices>

</msxconfig>
