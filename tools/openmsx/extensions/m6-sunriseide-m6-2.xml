<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>Sunrise ATA-IDE with the m6 kernel ROM, master and slave</name>
    <manufacturer>Sunrise</manufacturer>
    <code/>
    <release_year>1995</release_year>
    <description>ATA-IDE interface with the m6 kernel ROM (build/m6-sunriseide.rom, copied into the ROM pool by the harness; no checksum, the ROM changes with every build) and two hard disks: the master given with -hda, the slave with the hdb command before the machine boots.</description>
    <type>external hard disk</type>
  </info>
  <devices>
    <primary slot="any">
      <secondary slot="any">
        <SunriseIDE id="Sunrise IDE">
          <mem base="0x0000" size="0x10000"/>
          <rom>
            <filename>../systemroms/m6-sunriseide.rom</filename>
          </rom>
          <master>
            <type>IDEHD</type>
            <filename>hd_master.dsk</filename>
            <size>2</size>
          </master>
          <slave>
            <type>IDEHD</type>
            <filename>hd_slave.dsk</filename>
            <size>2</size>
          </slave>
        </SunriseIDE>
      </secondary>
    </primary>
  </devices>
</msxconfig>
