# The product test's script. Every check leaves its result in a file
# under /t, which the host reads back from the image; the screen shows
# the shell's own reports. The last line is what the harness waits for.
echo 1 hello > /t/r1
echo a b  c "d  e" 'f g' > /t/r2
echo -n no newline > /t/r3
cat /t/r1 /t/r2 > /t/r4
cat < /t/r1 > /t/r5
echo x >> /t/r5
cat /t/r1 /t/nofile > /t/r6 2> /t/r6e
wc /t/r4 > /t/r7
echo one two three | wc -w > /t/r8
cat /t/r4 | cat | wc -l > /t/r9
cd /t
echo r1 r? > r10
echo z* > r11
echo '*' > r12
cat < r1 > r13
cd /
true; echo 14 > /t/r14
false; echo 15 > /t/r15
nofile > /t/r16 2> /t/r16e
sh < /t/inner > /t/r17
echo 18 > /t/r18 &
# The file commands. What they make lives under /t/d and on the second
# volume, and is gone again before the listing of /t that ends the block;
# the checks that must fail run in a nested script, so their reports are
# files too and the screen keeps its rows.
mkdir /t/d
cp /t/r1 /t/d
cp /t/r14 /t/r15 /t/d
cp /t/d/r1 /t/d/c1
mv /t/d/c1 /t/d/m1
mkdir /t/d/sub
mv /t/d/r14 /t/d/r15 /t/d/sub
ls /t/d > /t/r20
ls /t/d/r1 > /t/r21
ls /t/d/sub /t/d > /t/r22
ls /mnt > /t/r23
ls -l /t/d > /t/r24
cp /t/r1 /mnt/b/x
ls /mnt/b > /t/r25
mv /mnt/b/x /mnt/b/y
ls /mnt/b >> /t/r25
rm /mnt/b/y
head -n 2 /t/r4 > /t/r26
head -n 1 /t/r1 /t/r2 > /t/r27
tail -n 1 /t/r4 > /t/r28
cat /t/r4 | tail -n 1 > /t/r29
tail -n 1 /t/r3 > /t/r30
chmod +r /t/d/r1
ls -l /t/d/r1 > /t/r31
sh < /t/fails > /t/r32 2> /t/r32e
chmod -r /t/d/r1
cd /t/d
pwd > /t/r33
cd /
rm /t/d/m1 /t/d/r1 /t/d/sub/r14 /t/d/sub/r15
rmdir /t/d/sub /t/d
ls /t > /t/r34
# The text and process commands. The checks that must fail join /t/fails;
# ps and kill run in /t/procs, a nested script whose pids are known in
# advance because a new process takes the first free row of the table.
grep b /t/r4 > /t/r36
grep -n hello /t/r1 /t/r4 > /t/r37
grep -v hello /t/r4 > /t/r38
cat /t/r4 | grep hello > /t/r39
sort /t/words > /t/r40
cat /t/words | sort > /t/r41
sort /t/words | uniq > /t/r42
uniq /t/words > /t/r43
cat /t/words | uniq > /t/r44
ls /bin | sort | uniq | wc -l > /t/r45
echo hello | tr a-z A-Z > /t/r46
tr '\n' ' ' < /t/words > /t/r47
cat /t/r4 | tee /t/r48 /t/r49 > /t/r50
echo more | tee -a /t/r48 > /t/r51
cat /big | tee /t/copy3 | wc -c > /t/r52
date > /t/r53
head -n 2 /etc/bench1 > /t/r58
cat /etc/bench1 | head -n 3 | wc -l > /t/r59
# more: with its messages in a file there is no terminal to page on, so
# /rows, 24 rows on the screen, goes through whole with no prompt; an
# input shorter than a screen never stops.
more /rows 2> /t/r60e | wc -l > /t/r60
cat /t/r4 | more > /t/r61
# Long names: listed as written, expanded by a glob, and a line of the
# length a long path needs.
ls /lfn > /t/r55
echo /lfn/Long* > /t/r56
echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx > /t/r57
/t/tick > /t/s1; sleep 1; /t/tick > /t/s2
sh < /t/procs > /t/r54 2> /t/r54e
sh < /etc/bench1
sh < /etc/bench2
# The response delay: the largest gap between two tick reads beside a cp
# of 64 KB, which gap starts itself so that it is in its loop before the
# copy begins on every host; the line ends in ok when the gap is within 8
# ticks. The two stamps around the second copy give a copy's span alone.
/t/gap 8 /bin/cp /big /t/copy > /t/r35
/t/tick > /t/t1; cp /big /t/copy2; /t/tick > /t/t2
echo rc done
