# The legacy subsystem's script. Every program here is a raw .COM under
# /dos, run through dos; what it prints goes to the screen through the
# BIOS, so the harness reads the rows. The last line is what it waits for.
echo rc start
# A pipe before the first program: the pipe buffers overwrite the kernel's
# boot code, and a program's exit must need none of it — a regression there
# fails here, not on a user's machine. A text line, not a number: the
# harness reads every number on the screen as a timestamp.
cat /etc/rc | grep buffers
dos /dos/hello.com
dos /dos/exit7.com
dos /dos/jp0.com
dos /dos/ret.com
dos /dos/mapper.com
dos /dos/con10k.com
# A second live process on the base machine leaves no segment for the
# program: the launch is refused there and succeeds on the 4 MB machine.
# The sleep is the first free row, 2.
sleep 600 &
dos /dos/hello.com
kill 2
# The shell's own way: a word ending in .com runs through dos.
/dos/hello.com
nofile.com
# The launch line: sixty of a 30K program between two ticks, here and not
# in a nested script, whose shell would take the one segment the program
# needs on the 128K machine. The file is written by files.tcl.
